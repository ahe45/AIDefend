<resources>
    <style name="Theme.GlassesScanner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="materialButtonStyle">@style/Widget.GlassesScanner.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.GlassesScanner.OutlinedButton</item>
    </style>
    <style name="Theme.GlassesScanner.Starting" parent="Theme.GlassesScanner">
        <item name="android:windowBackground">@drawable/launch_window</item>
    </style>
    <style name="Widget.GlassesScanner.Button" parent="Widget.Material3.Button">
        <item name="icon">@drawable/ic_action</item><item name="iconGravity">textStart</item>
    </style>
    <style name="Widget.GlassesScanner.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="icon">@drawable/ic_action</item><item name="iconGravity">textStart</item>
        <item name="cornerRadius">12dp</item><item name="android:minHeight">56dp</item>
    </style>
    <style name="Widget.GlassesScanner.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="icon">@drawable/ic_action</item><item name="iconGravity">textStart</item>
    </style>
</resources>
