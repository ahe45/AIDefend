<resources>
    <style name="Widget.GlassesScanner.PermissionButton" parent="Widget.GlassesScanner.Button">
        <item name="backgroundTint">@color/permission_green</item>
        <item name="android:textColor">@color/permission_card</item>
        <item name="iconTint">@color/permission_card</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.GlassesScanner.PermissionOutlinedButton" parent="Widget.GlassesScanner.OutlinedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/permission_green</item>
        <item name="iconTint">@color/permission_green</item>
        <item name="strokeColor">@color/permission_green</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
