<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/permission_screen" android:layout_width="match_parent" android:layout_height="0dp"
    android:layout_weight="1" android:fillViewport="true" android:visibility="gone"
    android:background="@color/permission_background">
    <LinearLayout android:id="@+id/permission_content"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="24dp" android:layout_height="28dp"
                android:src="@drawable/ic_permission_shield" app:tint="@color/permission_green"
                android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="@string/permission_brand"
                android:textColor="@color/permission_text" android:textSize="19sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/permission_title"
            android:textColor="@color/permission_green" android:textSize="28sp"
            android:textStyle="bold" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/permission_intro"
            android:textColor="@color/permission_muted" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:layout_marginBottom="10dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="8dp"
                android:layout_weight="1" android:orientation="horizontal" android:importantForAccessibility="noHideDescendants">
                <View android:id="@+id/permission_segment_location" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" />
                <View android:id="@+id/permission_segment_nearby" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" />
                <View android:id="@+id/permission_segment_notifications" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" />
                <View android:id="@+id/permission_segment_overlay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" />
                <View android:id="@+id/permission_segment_background" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            </LinearLayout>
            <TextView android:id="@+id/permission_state"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/permission_green" android:textSize="15sp"
                android:textStyle="bold" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <include android:id="@+id/permission_location_card" layout="@layout/permission_card" />
        <include android:id="@+id/permission_nearby_card" layout="@layout/permission_card" />
        <include android:id="@+id/permission_notifications_card" layout="@layout/permission_card" />
        <include android:id="@+id/permission_overlay_card" layout="@layout/permission_card" />
        <include android:id="@+id/permission_background_card" layout="@layout/permission_card" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/background_help" android:textColor="@color/permission_muted" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/permission_continue"
            style="@style/Widget.GlassesScanner.PermissionButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:minHeight="48dp" android:textSize="16sp"
            android:text="@string/permission_next"
            app:icon="@drawable/ic_permission_settings" />
        <com.google.android.material.button.MaterialButton android:id="@+id/permission_app_settings"
            style="@style/Widget.GlassesScanner.PermissionOutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:minHeight="48dp" android:text="@string/permission_app_settings"
            android:textSize="16sp" app:icon="@drawable/ic_open_settings" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:text="@string/permission_footer"
            android:textColor="@color/permission_muted" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
