<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scan_screen" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="@dimen/space_medium" android:paddingEnd="@dimen/space_medium">

    <include layout="@layout/scan_header" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/results"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="@dimen/space_small" />

    <com.google.android.material.card.MaterialCardView android:id="@+id/detail_pane"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="@dimen/space_medium" android:layout_marginBottom="@dimen/space_small"
        android:visibility="gone">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:id="@+id/detail_content" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_medium" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
