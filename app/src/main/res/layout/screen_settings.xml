<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="@dimen/space_medium">

    <LinearLayout style="@style/Widget.DeviceGuard.SettingsGroup"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView style="@style/Widget.DeviceGuard.SettingsSection" android:accessibilityHeading="true"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_section_scan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/categories_setting" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/detection_settings_button" app:icon="@drawable/ic_stat_scan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/advanced_scan_settings" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_advanced_scan" app:icon="@drawable/ic_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/default_duration" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_scan_duration" app:icon="@drawable/ic_history" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/background_battery" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_background_execution" app:icon="@drawable/ic_permission_battery" />
    </LinearLayout>

    <LinearLayout style="@style/Widget.DeviceGuard.SettingsGroup"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView style="@style/Widget.DeviceGuard.SettingsSection" android:accessibilityHeading="true"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_section_alerts" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/candidate_alert_settings" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/candidate_alerts_setting" app:icon="@drawable/ic_permission_bell" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlay_alert_settings" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/overlay_alert_setting" app:icon="@drawable/ic_permission_overlay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/candidate_sound_settings" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/candidate_sound_settings" app:icon="@drawable/ic_permission_bell" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/os_notifications" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/os_notifications_setting" app:icon="@drawable/ic_permission_bell" />
    </LinearLayout>

    <LinearLayout style="@style/Widget.DeviceGuard.SettingsGroup"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView style="@style/Widget.DeviceGuard.SettingsSection" android:accessibilityHeading="true"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_section_history" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manage_targets" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/targets_title" app:icon="@drawable/ic_stat_scan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retention" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_history_retention" app:icon="@drawable/ic_history" />
    </LinearLayout>

    <LinearLayout style="@style/Widget.DeviceGuard.SettingsGroup"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView style="@style/Widget.DeviceGuard.SettingsSection" android:accessibilityHeading="true"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_section_app" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/theme" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_theme" app:icon="@drawable/ic_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/required_permissions" style="@style/Widget.DeviceGuard.SettingsRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_required_permissions" app:icon="@drawable/ic_permission_settings" />

        <LinearLayout android:id="@+id/settings_version_row"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_medium" android:paddingVertical="12dp">
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_medium" android:text="@string/settings_app_version"
                android:textColor="@color/on_surface" android:textAppearance="?attr/textAppearanceBodyLarge" />
            <TextView android:id="@+id/settings_app_version"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/muted" android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
