<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_small" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:minHeight="@dimen/touch_min" android:padding="@dimen/space_medium">
        <TextView android:id="@+id/result_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
        <TextView android:id="@+id/result_metadata" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/muted" />
        <TextView android:id="@+id/result_reason" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
