<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="@dimen/space_medium">
    <TextView
        android:id="@+id/history_session_counts" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="@dimen/space_small"
        android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@color/on_surface" />
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/history_candidates_only" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="end"
        android:minHeight="@dimen/touch_min" android:text="@string/candidates_only"
        android:saveEnabled="false" />
    <TextView
        android:id="@+id/history_session_notice" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingBottom="@dimen/space_small"
        android:textColor="@color/muted" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_session_results" android:layout_width="match_parent"
            android:layout_height="match_parent" android:clipToPadding="false" />
        <ScrollView android:id="@+id/history_session_empty_scroll" android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView android:id="@+id/history_session_empty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="@dimen/space_medium"
                android:textColor="@color/muted" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
