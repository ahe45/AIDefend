<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scan_controls"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="@dimen/space_small" android:paddingBottom="@dimen/space_small">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <com.google.android.material.button.MaterialButton android:id="@+id/scan_action"
            android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="@dimen/space_small"
            android:layout_height="@dimen/scan_control_height" android:insetTop="0dp" android:insetBottom="0dp"
            android:textSize="22sp" android:textStyle="bold" android:includeFontPadding="false" app:icon="@drawable/ic_play"
            app:iconGravity="textStart" app:iconSize="32dp" android:text="@string/scan_start" />
        <com.google.android.material.button.MaterialButton android:id="@+id/select_categories"
            style="@style/Widget.DeviceGuard.OutlinedButton" android:layout_width="56dp"
            android:layout_height="@dimen/scan_control_height" android:insetTop="0dp" android:insetBottom="0dp"
            android:insetLeft="0dp" android:insetRight="0dp"
            android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"
            android:contentDescription="@string/detection_settings_button"
            app:icon="@drawable/ic_permission_settings" app:iconSize="26dp"
            app:iconPadding="0dp" app:iconGravity="textStart" />
    </LinearLayout>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/only_candidates"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end"
        android:minHeight="@dimen/touch_min" android:text="@string/candidates_only" />
    <TextView android:id="@+id/scan_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:textAppearance="?attr/textAppearanceTitleMedium"
        android:accessibilityLiveRegion="polite" />
    <com.google.android.material.button.MaterialButton android:id="@+id/recovery"
        style="@style/Widget.DeviceGuard.OutlinedButton" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:visibility="gone" />
    <TextView android:id="@+id/counts" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_small" android:textAppearance="?attr/textAppearanceLabelLarge" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/empty_results"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_small"
        app:cardBackgroundColor="@color/detail_section_background" app:cardCornerRadius="16dp"
        app:cardElevation="0dp" app:strokeColor="@color/detail_section_outline" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal" android:padding="@dimen/space_medium">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_stat_scan" app:tint="@color/brand" />
            <TextView android:id="@+id/empty_results_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center" android:accessibilityHeading="true"
                android:layout_marginTop="@dimen/space_small" android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/on_surface" android:text="@string/scan_empty_title" />
            <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="4dp" android:textColor="@color/muted"
                android:text="@string/scan_empty_guide" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
