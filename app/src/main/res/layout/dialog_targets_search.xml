<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingHorizontal="24dp" android:paddingTop="12dp">
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/targets_search_hint"
        app:boxBackgroundMode="outline" app:endIconMode="clear_text">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/targets_search" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text"
            android:imeOptions="actionSearch" android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
